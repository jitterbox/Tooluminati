{
  "name": "@tooluminati/angular-troubleshooting",
  "version": "0.1.0",
  "description": "Angular troubleshooting bundle with timeline, blockers, and dev panel.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "typecheck": "ngc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tooluminati/angular": "workspace:*",
    "@tooluminati/core": "workspace:*",
    "@tooluminati/diagnostics": "workspace:*",
    "@tooluminati/forms": "workspace:*",
    "@tooluminati/policies": "workspace:*",
    "tslib": "^2.8.0"
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tooluminati",
    "webmcp",
    "angular",
    "troubleshooting",
    "diagnostics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitterbox/Tooluminati.git",
    "directory": "packages/angular-troubleshooting"
  },
  "bugs": {
    "url": "https://github.com/jitterbox/Tooluminati/issues"
  },
  "homepage": "https://github.com/jitterbox/Tooluminati#readme",
  "engines": {
    "node": ">=18"
  }
}
