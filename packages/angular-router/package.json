{
  "name": "@tooluminati/angular-router",
  "version": "0.2.0",
  "description": "Angular Router diagnostics adapters for Tooluminati.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "typecheck": "ngc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tooluminati/angular": "workspace:*",
    "@tooluminati/router": "workspace:*",
    "tslib": "^2.8.0"
  },
  "peerDependencies": {
    "@angular/core": ">=20.0.0 <23.0.0",
    "@angular/router": ">=20.0.0 <23.0.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tooluminati",
    "webmcp",
    "angular",
    "router"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitterbox/Tooluminati.git",
    "directory": "packages/angular-router"
  },
  "bugs": {
    "url": "https://github.com/jitterbox/Tooluminati/issues"
  },
  "homepage": "https://github.com/jitterbox/Tooluminati#readme",
  "engines": {
    "node": ">=18"
  }
}
