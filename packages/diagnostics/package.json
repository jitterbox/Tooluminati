{
  "name": "@react-webmcp-diagnostics/diagnostics",
  "version": "0.0.0",
  "description": "Opinionated runtime diagnostics tools for React WebMCP Diagnostics.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-webmcp-diagnostics/core": "workspace:*"
  },
  "files": ["dist"],
  "license": "MIT"
}
