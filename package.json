{
  "name": "tooluminati",
  "version": "0.0.0",
  "private": true,
  "description": "Expose tools. Share context. Empower agents.",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitterbox/Tooluminati.git"
  },
  "bugs": {
    "url": "https://github.com/jitterbox/Tooluminati/issues"
  },
  "homepage": "https://github.com/jitterbox/Tooluminati#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "tsc -b tsconfig.packages.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:browser": "playwright test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "sync-package-metadata": "node scripts/sync-package-metadata.mjs"
  },
  "keywords": [
    "webmcp",
    "react",
    "diagnostics",
    "agent-observability",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "jitterbox",
  "devDependencies": {
    "@angular/build": "^20.3.28",
    "@angular/cli": "^20.3.28",
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/compiler-cli": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^20.3.25",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@angular/router": "^20.3.25",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.1",
    "@ngrx/store": "^20.1.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.9.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.7",
    "vitest": "^4.1.10",
    "zone.js": "^0.16.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
